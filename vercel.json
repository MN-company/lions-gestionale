{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source":"/.well-known/oauth-protected-resource/api/mcp","destination":"/api/mcp?metadata=1"},
    {"source":"/.well-known/oauth-protected-resource","destination":"/api/mcp?metadata=1"},
    {"source":"/oauth/consent","destination":"/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}
